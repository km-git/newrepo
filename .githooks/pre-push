#!/usr/bin/env bash
# Optional pre-push reminder for proof-governed branches touching execution code.
set -euo pipefail

if [[ "${EW_SKIP_PROOF_HOOKS:-0}" == "1" ]]; then
  exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Only nudge on cursor/* feature branches when recent commits touch execution paths.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
[[ "$branch" == cursor/* ]] || exit 0

if ! git rev-parse @{u} >/dev/null 2>&1; then
  exit 0
fi

range="$(git merge-base HEAD @{u})..HEAD"
changed="$(git diff --name-only "$range" 2>/dev/null || true)"
[[ -n "$changed" ]] || exit 0

if echo "$changed" | grep -qE '^(engine/(paper_|continuous_proof|execution_gates)|scripts/run_(continuous_proof|paper_proof))'; then
  echo "[pre-push] Tip: run full proof before merge:" >&2
  echo "  bash scripts/hooks/run_proof_gate.sh full" >&2
  echo "  or GitHub Actions → Proof gate → Run workflow" >&2
fi

exit 0
